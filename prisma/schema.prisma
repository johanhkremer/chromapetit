generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Paint {
  id           String   @id @default(cuid())
  name         String
  brand        String
  hexCode      String
  opacity      Float?
  // Example: "base", "layer", "contrast", "technical", "wash", "dry", "air", "ink"
  category     String
  // Example: "Matte", "Glossy", "Satin", "Metallic", "Fluorescent", "Pearlescent"
  tags         String[]
  discontinued Boolean  @default(false)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  blue         Int
  green        Int
  red          Int

  @@unique([name, brand])
  @@index([name])
  @@index([brand])
}
